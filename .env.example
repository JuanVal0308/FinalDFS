# =============================================================================
# CONFIGURACIÓN DEL ENTORNO — FinalDFS
# =============================================================================
# Copia este archivo como ".env" en la raíz del proyecto y ajusta los valores
# según el entorno de despliegue.
#
#   cp .env.example .env
#
# El archivo .env es cargado automáticamente por Docker Compose.
# =============================================================================

# -----------------------------------------------------------------------------
# IP PÚBLICA del host donde corren los contenedores.
#
# ► LOCAL (laptop/PC):
#       PUBLIC_IP=localhost
#
# ► EC2 (AWS):
#       PUBLIC_IP=52.23.74.126    ← reemplaza con la IP pública de tu instancia
#
# Esta variable construye las URLs que el NameNode devuelve al cliente
# en el endpoint /files/allocate, para que el cliente pueda subir/bajar
# bloques directamente a los DataNodes desde fuera de Docker.
# -----------------------------------------------------------------------------
PUBLIC_IP=localhost
