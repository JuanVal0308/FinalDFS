# Credenciales del NameNode — copiar a namenode/.env
#   cp namenode/.env.example namenode/.env
#
# Este archivo NO se sube al repositorio (.gitignore).

# MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Clave secreta del servidor para firmar tokens JWT (inventar una cadena larga)
# NO es la contraseña del usuario ni el token de sesión.
JWT_SECRET=changeme-secret
